    "@yokosocial/config": "*",
    "@yokosocial/database": "*",
    "@yokosocial/media": "*",
    "@yokosocial/postiz": "*",
    "@yokosocial/shared": "*",
    "@yokosocial/website-importer": "*",
    "bullmq": "^5.58.0",
    "ioredis": "^5.7.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  }
}
