{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/worker.Dockerfile",
    "watchPatterns": [
      "apps/worker/**",
      "packages/**",
      "docker/worker.Dockerfile",
      "package.json",
      "package-lock.json",
      "turbo.json",
      "tsconfig.base.json",
      "railway.worker.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 30
  }
}
